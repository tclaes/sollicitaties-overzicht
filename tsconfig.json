{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./app/*"
      ],
      "~/elements/*": [
        "./app/components/elements/*"
      ]
    }
  },
  "include": [
    "app",
    "scripts",
    "app/types",
    "e2e",
    "playwright.config.ts"
  ]
}
