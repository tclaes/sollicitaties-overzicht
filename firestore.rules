rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sollicitaties/{id} {
      allow read, write: if request.auth != null && request.auth.token.email == "tom.claes82@gmail.com";
    }
    match /overzicht/{id} {
      allow read, write: if request.auth != null && request.auth.token.email == "tom.claes82@gmail.com";
    }
  }
}
